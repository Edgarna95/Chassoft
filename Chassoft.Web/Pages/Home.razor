@page "/"

<PageTitle>Chassoft</PageTitle>

<div class="container mt-4">
    <h1 class="mb-3">Panel de Control</h1>
    <p class="text-muted">Gestión administrativa de socios, proveedores y caja.</p>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <a href="/proveedores" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center py-4">
                        <div class="fs-1 mb-2">🏢</div>
                        <h5 class="card-title">Proveedores</h5>
                        <p class="card-text text-muted small">Gestioná el padrón de proveedores del club.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/socios" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center py-4">
                        <div class="fs-1 mb-2">👥</div>
                        <h5 class="card-title">Socios</h5>
                        <p class="card-text text-muted small">Administrá el padrón de socios y su estado.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/operaciones" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center py-4">
                        <div class="fs-1 mb-2">💰</div>
                        <h5 class="card-title">Operaciones</h5>
                        <p class="card-text text-muted small">Registrá ingresos y egresos del club.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
